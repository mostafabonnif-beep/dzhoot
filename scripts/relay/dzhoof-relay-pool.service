[Unit]
Description=DZ HOOF city relay pool (smart SOCKS distributor 127.0.0.1:9000)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/dzhoof/relay/relay-pool.py
Restart=always
RestartSec=3
User=root
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
