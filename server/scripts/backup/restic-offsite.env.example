# DZ HOOF off-site encrypted backup configuration.
# Copy this file to /etc/dzhoot/restic-offsite.env and chmod 600 it.
# Never commit the copied file, the password file, SSH key, or cloud credentials.

# Choose exactly one restic repository URL.
# SFTP example (a second server or storage account you control):
# OFFSITE_RESTIC_REPOSITORY=sftp:backup-user@backup.example.net:/srv/dzhoof-restic
#
# S3-compatible example (requires the optional credentials below):
# OFFSITE_RESTIC_REPOSITORY=s3:https://s3.example.net/dzhoof-restic
OFFSITE_RESTIC_REPOSITORY=

# A separate file containing only the restic repository encryption password.
# Create it outside Git: install -m 600 /dev/null /etc/dzhoot/restic-offsite-password
OFFSITE_RESTIC_PASSWORD_FILE=/etc/dzhoot/restic-offsite-password

# Optional: required only for S3-compatible storage. Leave unset for SFTP.
# OFFSITE_AWS_ACCESS_KEY_ID=
# OFFSITE_AWS_SECRET_ACCESS_KEY=
# OFFSITE_AWS_DEFAULT_REGION=
