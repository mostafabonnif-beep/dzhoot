[Unit]
Description=Verify DZ HOOF encrypted off-site recovery repository
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/dzhoot/server/scripts/backup/restic-offsite-backup.sh --check
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/backups/dzhoot /etc/dzhoot /opt/dzhoot/server
