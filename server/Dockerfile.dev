FROM node:26.8.1-alpine

WORKDIR /app

# Install dependencies for native modules and yt-dlp for YouTube stream resolution
RUN apk add --no-cache python3 make g++ curl && \
    curl -fL --retry 5 --retry-all-errors --connect-timeout 15 -o /usr/local/bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/download/2026.08.19/yt-dlp && \
    echo "1fa6733c37ea6fb51c99ad8fe785e7b7e5f3246c9b980230329d4fb72ed8d4d6  /usr/local/bin/yt-dlp" | sha256sum -c - && \
    chmod +x /usr/local/bin/yt-dlp

# Copy workspace root and package files
COPY package*.json ./
COPY backend/package*.json ./backend/
COPY frontend/package*.json ./frontend/
COPY packages/shared/package*.json ./packages/shared/

# Install all dependencies
RUN npm ci --ignore-scripts && npm cache clean --force

# Copy shared package source and build it
COPY packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src ./packages/shared/src
RUN npx -w @dzhoof/shared tsc

# Copy backend tsconfig (needed by tsx for path resolution)
COPY backend/tsconfig.json ./backend/

# Create directories for uploads and APKs
RUN mkdir -p uploads apks && chmod 755 uploads apks

EXPOSE 3000

# Use tsx watch for hot reload
CMD ["npx", "tsx", "watch", "backend/src/server.js"]
