{$DOMAIN} {
    encode gzip zstd
    tls {$ACME_EMAIL}

    @api path /api/* /health /health/* /ready /ready/*
    handle @api {
        reverse_proxy api:3000
    }

    handle {
        reverse_proxy frontend:3000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Permitted-Cross-Domain-Policies "none"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), autoplay=(self)"
        # Conservative CSP for the Next.js admin dashboard. 'unsafe-inline' is
        # required for Next.js hydration payloads; everything else is scoped to
        # self / explicit Google domains (reCAPTCHA) and blob/https media.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; font-src 'self' data:; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
}
