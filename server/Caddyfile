{
    # Caddy's admin API (default localhost:2019) is not used by this stack;
    # disabling it shrinks the local attack surface.
    admin off
}

# MIRROR_DOMAIN (optional, env): a second public hostname served by the same
# stack (ISP-block resilience). Empty by default — the header stays "{$DOMAIN}".
# The literal space below is the site-address separator, so both a bare host and
# the historical comma-prefixed value work (Caddy accepts spaces and commas):
#   MIRROR_DOMAIN=mirror.example.com    ->  "{$DOMAIN} mirror.example.com"
#   MIRROR_DOMAIN=, mirror.example.com  ->  "{$DOMAIN} , mirror.example.com"
# NOTE: keep that space — without it a comma-free value would be concatenated
# into one bogus hostname and break TLS/ACME.
{$DOMAIN} {$MIRROR_DOMAIN} {
    encode gzip zstd
    tls {$ACME_EMAIL}

    # File access log, watched by the fail2ban jail `dzhoof-http`.
    # The jail and its filter ARE shipped now: scripts/security/fail2ban/ +
    # scripts/security/setup-fail2ban-http-jail.sh (idempotent, validates the filter
    # against this log before reloading). It bans 6x 401/403 in 60s for an hour, and —
    # since 2026-09-15 — also a client that posts fabricated `Next-Action` headers
    # (a real server-action id is 42 characters; the scanner that produced the 75
    # `Server Reference ID did not match the expected format` errors sent "x"/"0").
    # A fresh host must run that script for this log to be watched.
    log {
        output file /data/access.log {
            roll_size 50MiB
            roll_keep 3
        }
        format json
    }

    @api path /api/* /health /health/* /ready /ready/*
    handle @api {
        reverse_proxy api:3000
    }

    # Self-hosted APK distribution (2026-09-23): the published release's
    # downloadUrl points at a file in this directory (AppVersion row), so
    # /downloads/*.apk must serve the file directly. The former 302 of
    # /downloads/*.apk to /api/v1/app/download is gone — the canonical route now
    # redirects BACK to a /downloads/ path, so keeping it would create a loop.
    handle_path /downloads/* {
        root * /downloads
        file_server
    }

    # --- Cache policy for app routes (2026-09-15) ---------------------------
    # Next.js answers prerendered HTML with `s-maxage=31536000` (a year, no max-age).
    # Nothing here is behind a CDN today, so the risk is latent — but a shared cache
    # honouring that header would pin HTML naming action ids and chunk paths from an
    # older release than the chunks it references: the mixed-release failure the
    # atomic deploy otherwise prevents (observed on /, /admin, /login, /register).
    #
    # It MUST be `header_down` (inside reverse_proxy), not the `header` directive:
    # a response header set by `header` — at site level or inside this handle block —
    # is overwritten when the proxy copies the upstream response (measured twice on
    # 2026-09-15: the HTML still carried s-maxage=31536000 after a reload with the
    # directive in place at both levels).
    #
    # Extension-less, non-API paths are the app's routes (HTML / RSC payloads).
    # Everything genuinely cacheable is content-hashed under /_next/static/ or
    # carries a file extension and keeps Next.js's own `immutable` header —
    # including /_next/image, which also has no dot in its path and is excluded here.
    @documentRoute {
        path_regexp documentRoute ^/[^.]*$
        not path /_next/* /api/* /downloads/* /health*
    }
    handle @documentRoute {
        reverse_proxy frontend:3000 {
            header_down >Cache-Control "no-store"
        }
    }

    handle {
        reverse_proxy frontend:3000
    }

    # Defense-in-depth headers. CSP remains application-owned because Next.js
    # emits framework scripts whose nonces/hashes must stay aligned with builds.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Permitted-Cross-Domain-Policies "none"
        Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
        # NOTE: no global X-Robots-Tag — the marketing pages must be indexable
        # for market entry. Private areas are blocked via /robots.txt instead
        # (the Next.js app also emits index,follow meta on public pages).
        # Conservative CSP for the Next.js admin dashboard (audit-remediation-v1).
        # 'unsafe-inline' is required for Next.js hydration payloads; everything
        # else is scoped to self / explicit Google domains (reCAPTCHA) and
        # blob/https media.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; font-src 'self' data:; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        -Server
        -X-Powered-By
    }
}
