{
    # Caddy's admin API (default localhost:2019) is not used by this stack;
    # disabling it shrinks the local attack surface.
    admin off
}

# MIRROR_DOMAIN (optional, env): a second public hostname served by the same
# stack (ISP-block resilience). Empty by default — the header stays "{$DOMAIN}".
# The literal space below is the site-address separator, so both a bare host and
# the historical comma-prefixed value work (Caddy accepts spaces and commas):
#   MIRROR_DOMAIN=mirror.example.com    ->  "{$DOMAIN} mirror.example.com"
#   MIRROR_DOMAIN=, mirror.example.com  ->  "{$DOMAIN} , mirror.example.com"
# NOTE: keep that space — without it a comma-free value would be concatenated
# into one bogus hostname and break TLS/ACME.
{$DOMAIN} {$MIRROR_DOMAIN} {
    encode gzip zstd
    tls {$ACME_EMAIL}

    # File access log, watched by the fail2ban jail `dzhoof-http` on the
    # production host (/etc/fail2ban/jail.d/dzhoof-http.local: 6x 401/403 in 60s
    # -> 1h ban). NOTE: that jail is configured on the host, NOT shipped in this
    # repo — only scripts/security/secure-ssh-setup.sh defines the sshd jail.
    # A fresh host must create the jail for this log to be watched.
    # TODO: ship the jail definition under scripts/security/.
    log {
        output file /data/access.log {
            roll_size 50MiB
            roll_keep 3
        }
        format json
    }

    @api path /api/* /health /health/* /ready /ready/*
    handle @api {
        reverse_proxy api:3000
    }

    @legacyApkDownload path_regexp legacyApkDownload ^/downloads/[^/]+\.apk$
    redir @legacyApkDownload /api/v1/app/download 302

    handle_path /downloads/* {
        root * /downloads
        file_server
    }

    handle {
        reverse_proxy frontend:3000

        # --- Cache policy for app routes (2026-09-15) ---------------------------
        # Next.js answers prerendered HTML with `s-maxage=31536000` (one year, no
        # max-age). Nothing in this stack is behind a CDN today, so the risk is
        # latent — but a shared cache that honoured that header would pin HTML that
        # names action ids and `/_next/static/...` chunk paths from an older release
        # than the chunks themselves: the mixed-release failure the atomic deploy
        # otherwise prevents (observed header on /, /admin, /login, /register).
        #
        # Extension-less paths are the app's routes (HTML / RSC payloads). Every
        # genuinely cacheable asset is content-hashed and lives under /_next/static/
        # or carries a file extension, so it never matches this matcher and keeps
        # Next.js's own `public, max-age=31536000, immutable`.
        # `/_next/*` is excluded explicitly: `/_next/image` has no dot in its path
        # either, and it is a genuinely cacheable optimizer response.
        @documentRoute {
            path_regexp documentRoute ^/[^.]*$
            not path /_next/*
        }
        header @documentRoute >Cache-Control "no-store"
    }

    # Defense-in-depth headers. CSP remains application-owned because Next.js
    # emits framework scripts whose nonces/hashes must stay aligned with builds.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Permitted-Cross-Domain-Policies "none"
        Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
        # NOTE: no global X-Robots-Tag — the marketing pages must be indexable
        # for market entry. Private areas are blocked via /robots.txt instead
        # (the Next.js app also emits index,follow meta on public pages).
        # Conservative CSP for the Next.js admin dashboard (audit-remediation-v1).
        # 'unsafe-inline' is required for Next.js hydration payloads; everything
        # else is scoped to self / explicit Google domains (reCAPTCHA) and
        # blob/https media.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; font-src 'self' data:; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        -Server
        -X-Powered-By
    }
}
