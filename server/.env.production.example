# DZ HOOF IPTV — Production environment template
# Copy to .env.production and replace every CHANGE-ME/placeholder value.
# Never commit the real file.

NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0
DOCKER_IMAGE=ghcr.io/merci1994dz/dzhoot-backend:CHANGE-ME
DOCKER_FRONTEND_IMAGE=ghcr.io/merci1994dz/dzhoot-frontend:CHANGE-ME

# Public domain and automatic HTTPS via Caddy
DOMAIN=iptv.example.com
ACME_EMAIL=ops@example.com
APP_URL=https://iptv.example.com
PUBLIC_BASE_URL=https://iptv.example.com
ALLOWED_ORIGINS=https://iptv.example.com

# Database and cache
MONGODB_URI=mongodb://mongodb:27017/dzhoof-iptv
REDIS_URL=redis://dzhoof-redis:6379

# Secrets: generate each independently with: openssl rand -hex 32
XTREAM_SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
JWT_ACCESS_SECRET=CHANGE-ME-openssl-rand-hex-32
JWT_REFRESH_SECRET=CHANGE-ME-openssl-rand-hex-32
PLAYBACK_TOKEN_SECRET=CHANGE-ME-openssl-rand-hex-32
# AES-256-GCM key for encrypted admin TOTP secrets; generate independently with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=CHANGE-ME-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_MS=2592000000

# Initial administrator; rotate after first login
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=CHANGE-ME-long-random-password
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_CHANNEL_LIST_CODE=CHANGE-ME-channel-code

# Commercial access policy
SUBSCRIPTION_REQUIRED=true
DEMO_CHANNEL_LIST_CODE=CHANGE-ME-demo-code

# Firebase Cloud Messaging HTTP v1 (server-only service account fields)
# Create a restricted Firebase service account; store the real values in the deployment secret manager.
FCM_PROJECT_ID=CHANGE-ME-firebase-project-id
FCM_CLIENT_EMAIL=CHANGE-ME-firebase-client-email
# Keep escaped newlines (\\n) when supplying this through Docker/CI environment variables.
FCM_PRIVATE_KEY=CHANGE-ME-private-key
MAX_CONCURRENT_STREAMS_PER_USER=2

# Online payments — Chargily Pay (Algeria: EDAHABIA / CIB / Chargily app, DZD).
# Get the LIVE secret key from https://pay.chargily.com/dashboard/developers-corner
# after verifying the merchant account. Leave unset to keep online payment
# disabled (the /buy "pay by card" button stays hidden, checkout returns 503).
# CHARGILY_SECRET_KEY=CHANGE-ME-chargily-live-secret-key

# OAuth (optional; leave disabled until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://iptv.example.com/api/v1/auth/google/callback
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=
GH_OAUTH_REDIRECT_URI=https://iptv.example.com/api/v1/auth/github/callback

# Email provider
MAIL_PROVIDER=brevo
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USER=CHANGE-ME
BREVO_PASSWORD=CHANGE-ME
MAIL_FROM=noreply@example.com

# Optional frontend analytics and CAPTCHA
GA_MEASUREMENT_ID=
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=

# GitHub Releases APK delivery (optional)
GH_APP_OWNER=mostafabonnif-beep
GH_APP_REPO=dzhoot
GH_APP_APK_PATTERN=.apk
GH_APP_TOKEN=

# Scheduler and observability
DISABLE_SCHEDULER=true
LIVENESS_CHECK_INTERVAL_MS=86400000
EPG_REFRESH_INTERVAL_MS=21600000
# Keep XMLTV parsing memory bounded; raise to 2 only after observing ample headroom.
EPG_FETCH_CONCURRENCY=1
# Reject oversized decompressed XMLTV feeds before parser memory grows unbounded.
EPG_MAX_XML_MB=50
# Optional operator-approved extra XMLTV guides (JSON array of {url,label}); '*' coverage
# matches any channel whose tvgId/channelId equals a programme channel id (case-insensitive).
# EPG_EXTRA_SOURCES=[{"url":"https://epgshare01.online/epgshare01/epg_ripper_TR1.xml.gz","label":"epgshare-bein-tr"},{"url":"https://epgshare01.online/epgshare01/epg_ripper_BEIN1.xml.gz","label":"epgshare-bein-intl"}]
CACHE_REFRESH_INTERVAL_MS=3600000
STREAM_HEALTH_CHECK_INTERVAL_MS=14400000
XTREAM_SYNC_INTERVAL_MS=21600000
M3U_SYNC_INTERVAL_MS=21600000
BACKEND_SENTRY_DSN=
FRONTEND_SENTRY_DSN=
# Required only when enabling the optional Prometheus profile; generate with: openssl rand -hex 32
METRICS_BEARER_TOKEN=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_COOLDOWN_MS=900000
# Host-side backup job; keep the real backup env file outside Git with mode 0600.
BACKUP_DIR=/var/backups/dzhoot/mongodb
RETENTION_DAYS=14
TRUST_CF_CONNECTING_IP=false

# Keep video bytes off the DZ HOOF VPS for explicitly opted-in providers.
# WARNING: direct mode exposes the final provider playback URL to the client.
ALLOW_DIRECT_PLAYBACK=false
